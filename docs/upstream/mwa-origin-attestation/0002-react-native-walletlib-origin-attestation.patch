+/**
+ * TakumiPay fork: the value the dapp must present as `h` for `challenge`
+ * (`base64(SHA256("attest-origin" || challenge || session_secret))`). Computed
+ * natively because only the session holds the secret. Resolves `null` when the
+ * request is unknown or no encrypted session secret is available.
+ */
+export async function computeAttestOriginBinding(
+    request: AuthorizeDappRequest,
+    challenge: Uint8Array,
+): Promise<string | null> {
+    let binary = '';
+    for (let i = 0; i < challenge.length; i++) {
+        binary += String.fromCharCode(challenge[i]);
+    }
+    const challengeBase64 = typeof btoa === 'function' ? btoa(binary) : Buffer.from(challenge).toString('base64');
+    return await SolanaMobileWalletAdapterWalletLib.computeAttestOriginBinding(request.requestId, challengeBase64);
+}
