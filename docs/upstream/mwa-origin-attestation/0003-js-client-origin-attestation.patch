diff --git a/js/packages/mobile-wallet-adapter-protocol/src/attestOrigin.ts b/js/packages/mobile-wallet-adapter-protocol/src/attestOrigin.ts
--- a/js/packages/mobile-wallet-adapter-protocol/src/attestOrigin.ts
+++ b/js/packages/mobile-wallet-adapter-protocol/src/attestOrigin.ts
@@ -0,0 +1,139 @@
+import { SolanaMobileWalletAdapterError, SolanaMobileWalletAdapterErrorCode } from './errors.js';
+import { AttestBindingSecret } from './parseHelloRsp.js';
+
+/**
+ * Origin attestation for web dapp endpoints (spec: "Identity verification"
+ * > Android). On `ERROR_ATTEST_ORIGIN_ANDROID` the wallet hands us a
+ * challenge; we bind it to this session, load the wallet's attestation
+ * script in an iframe, and hand its signed answer back as `attest_origin`.
+ *
+ * Wire format of the iframe exchange (wallet-defined, see the wallet's
+ * attestation script for the authoritative version):
+ *   -> { m: 'origin-attest', h, context }
+ *   <- <token string>                                  success
+ *   <- { m: 'origin-attest-error', error }             failure; `error` is
+ *      'storage_access_required' when the browser partitions the script's
+ *      storage and needs a user gesture inside the frame. We then reveal
+ *      the frame so the user can grant it, and keep waiting.
+ */
+
+const ATTEST_ORIGIN_SILENT_TIMEOUT_MS = 15_000;
+const ATTEST_ORIGIN_INTERACTIVE_TIMEOUT_MS = 90_000;
+
+export type AttestOriginChallenge = Readonly<{
+    attest_origin_uri: string;
+    challenge: string;
+    context: string;
+}>;
+
+function base64ToBytes(b64: string): Uint8Array {
+    const bin = atob(b64);
+    const out = new Uint8Array(bin.length);
+    for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
+    return out;
+}
+
+function bytesToBase64(bytes: ArrayBuffer | Uint8Array): string {
+    const u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+    let s = '';
+    for (let i = 0; i < u8.length; i++) s += String.fromCharCode(u8[i]);
+    return btoa(s);
+}
+
+/** `h = base64(SHA256("attest-origin" || challenge || session_secret))` */
+export async function computeAttestOriginBinding(
+    challengeBase64: string,
+    attestBindingSecret: AttestBindingSecret,
+): Promise<string> {
+    const prefix = new TextEncoder().encode('attest-origin');
+    const challenge = base64ToBytes(challengeBase64);
+    const secret = new Uint8Array(attestBindingSecret);
+    const input = new Uint8Array(prefix.length + challenge.length + secret.length);
+    input.set(prefix, 0);
+    input.set(challenge, prefix.length);
+    input.set(secret, prefix.length + challenge.length);
+    return bytesToBase64(await crypto.subtle.digest('SHA-256', input));
+}
+
+function assertAttestOriginUri(uri: string): URL {
+    let url: URL;
+    try {
+        url = new URL(uri);
+    } catch {
+        throw new SolanaMobileWalletAdapterError(
+            SolanaMobileWalletAdapterErrorCode.ERROR_ATTEST_ORIGIN_FAILED,
+            'Invalid attestation script URI supplied by wallet',
+        );
+    }
+    if (url.protocol !== 'https:') {
+        throw new SolanaMobileWalletAdapterError(
+            SolanaMobileWalletAdapterErrorCode.ERROR_ATTEST_ORIGIN_FAILED,
+            'Attestation script URIs supplied by wallets must be `https` URLs',
+        );
+    }
+    return url;
+}
+
+export async function attestOrigin(
+    data: AttestOriginChallenge,
+    attestBindingSecret: AttestBindingSecret,
+): Promise<string> {
+    if (typeof document === 'undefined') {
+        throw new SolanaMobileWalletAdapterError(
+            SolanaMobileWalletAdapterErrorCode.ERROR_ATTEST_ORIGIN_FAILED,
+            'Origin attestation requires a browser document',
+        );
+    }
+    const scriptUrl = assertAttestOriginUri(data.attest_origin_uri);
+    const h = await computeAttestOriginBinding(data.challenge, attestBindingSecret);
+    return new Promise<string>((resolve, reject) => {
+        const iframe = document.createElement('iframe');
+        iframe.setAttribute('aria-hidden', 'true');
+        iframe.style.cssText =
+            'position:fixed;width:0;height:0;border:0;opacity:0;pointer-events:none;bottom:0;right:0;';
+        let timeoutId = 0;
+        const cleanup = () => {
+            window.clearTimeout(timeoutId);
+            window.removeEventListener('message', onMessage);
+            iframe.remove();
+        };
+        const fail = (message: string) => {
+            cleanup();
+            reject(new SolanaMobileWalletAdapterError(SolanaMobileWalletAdapterErrorCode.ERROR_ATTEST_ORIGIN_FAILED, message));
+        };
+        const arm = (ms: number) => {
+            window.clearTimeout(timeoutId);
+            timeoutId = window.setTimeout(() => fail('Timed out waiting for the origin attestation script'), ms);
+        };
+        const onMessage = (evt: MessageEvent) => {
+            if (evt.origin !== scriptUrl.origin || evt.source !== iframe.contentWindow) return;
+            const msg = evt.data;
+            if (typeof msg === 'string') {
+                cleanup();
+                resolve(msg);
+                return;
+            }
+            if (msg && typeof msg === 'object' && msg.m === 'origin-attest-error') {
+                if (msg.error === 'storage_access_required') {
+                    // The script needs a tap inside its own frame to reach its
+                    // first-party storage; show it and give the user time.
+                    iframe.removeAttribute('aria-hidden');
+                    iframe.style.cssText =
+                        'position:fixed;left:0;right:0;bottom:0;width:100%;height:220px;border:0;' +
+                        'border-top:1px solid rgba(0,0,0,.15);background:#fff;z-index:2147483647;';
+                    arm(ATTEST_ORIGIN_INTERACTIVE_TIMEOUT_MS);
+                    return;
+                }
+                fail(`Origin attestation failed (${String(msg.error)})`);
+            }
+        };
+        window.addEventListener('message', onMessage);
+        iframe.addEventListener('load', () => {
+            iframe.contentWindow?.postMessage({ m: 'origin-attest', h, context: data.context }, scriptUrl.origin);
+        });
+        iframe.addEventListener('error', () => fail('Failed to load the origin attestation script'));
+        arm(ATTEST_ORIGIN_SILENT_TIMEOUT_MS);
+        iframe.src = scriptUrl.href;
+        document.body.appendChild(iframe);
+    });
+}
